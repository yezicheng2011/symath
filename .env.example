# SyMath server deployment settings (copy to .env and edit). No secrets are needed.
# Public hostname served by nginx (certificate from Let's Encrypt under /etc/letsencrypt/live/$SYMATH_DOMAIN/)
SYMATH_DOMAIN=cas.example.com
# Static front-end releases (current -> releases/<timestamp>)
SYMATH_WEB_ROOT=/var/www/symath
# Python API releases + venv
SYMATH_APP_ROOT=/opt/symath
# Dedicated no-login system user that runs the API
SYMATH_SERVICE_USER=symath
# Loopback port of the API (nginx proxies /api/ to it)
SYMATH_API_PORT=8766
# Optional API runtime settings (read by backend/server.py)
# SYMATH_ALLOWED_ORIGINS=https://cas.example.com
# SYMATH_MEMORY_MB=1536
